<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <receiver
            android:name=".PluginDiscoveryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.nightfish.lightnovelreader.PLUGIN_DISCOVERY" />
            </intent-filter>
        </receiver>

        <activity
            android:name="io.legado.plugin.LoginActivity"
            android:label="书源登录"
            android:exported="true" />

        <activity
            android:name="io.legado.plugin.SourceManagerActivity"
            android:label="Legado 书源"
            android:exported="true" />

    </application>
</manifest>
